{
  "name": "tpg-punch-up-party",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tpgames/game-kit": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tpgames/core-manifest": "0.3.0",
    "@tpgames/sdk-dev-kit": "0.3.0",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "vite build",
    "bundle": "npm run build && tpgames bundle",
    "check": "npm run typecheck && npm run test && npm run validate",
    "check:capabilities": "node ./scripts/check-capabilities.mjs",
    "check:tpg-boundaries": "tpgames check-boundaries",
    "dev": "vite",
    "dev:devices": "tpgames dev --devices",
    "dev:scenarios": "vite --open /surfaces/scenarios.html",
    "test:e2e": "playwright test",
    "publish:dry-run": "npm run bundle && tpgames register --mode publish --dry-run",
    "publish:game": "npm run bundle && tpgames register --mode publish --yes",
    "register": "tpgames register",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "npm run check:tpg-boundaries && npm run check:capabilities && npm run bundle && tpg validate ./dist"
  }
}
