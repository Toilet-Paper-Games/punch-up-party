{
  "manifestVersion": "1",
  "gameId": "punch-up-party",
  "version": "0.1.6",
  "sdkVersion": "1.0.0",
  "title": "Punch Up!",
  "description": "Write the line, win the room, and earn top billing in a fast comedy showdown.",
  "surfaces": [
    {
      "id": "host",
      "kind": "host-display",
      "entry": "/host.html",
      "required": true
    },
    {
      "id": "controller",
      "kind": "controller",
      "entry": "/controller.html",
      "required": true
    },
    {
      "id": "spectator",
      "kind": "spectator",
      "entry": "/spectator.html",
      "required": false
    }
  ],
  "capabilities": [
    "player-state",
    "shared-state",
    "broadcast-messages"
  ],
  "permissions": [],
  "gameMetadata": {
    "primaryCategory": "party-activity",
    "secondaryCategories": [
      "word"
    ],
    "interactionMode": "competitive",
    "sessionPace": "quick",
    "playerCount": {
      "min": 3,
      "max": 8,
      "recommended": 5
    }
  },
  "presentationMetadata": {
    "shortDescription": "Write the line. Win the room.",
    "longDescription": "Turn ridiculous comedy setups into punchlines, face off anonymously, and vote for the lines that deserve top billing across two duel rounds and a triple-point finale.",
    "cardTitle": "PUNCH UP!",
    "tags": [
      "comedy",
      "party",
      "voting",
      "word-game"
    ],
    "legacyCategories": ["2d", "word-games"],
    "artwork": {
      "thumbnail": "assets/card-art.png",
      "card": "assets/card-art.png"
    },
    "launchColor": "#F4E8CF",
    "estimatedDurationMinutes": 12
  },
  "sessionTopology": {
    "display": "required",
    "supportsSpectators": true,
    "playableParticipantModes": [
      "controller"
    ]
  }
}
